    <project_license>GPL-3.0-only</project_license>
    <name>AudioMirroring</name>
    <summary>Audio Mirroring for Linux</summary>
    <description>
        <p>
            AudioMirroring allows mirroring audio sources to multiple output devices.
            It provides a simple interface to route audio from applications or devices
            to one or more speakers or audio outputs.
        </p>
    </description>
    <screenshots>
        <screenshot type="default">
            <image>https://github.com/mkg20001/audio-mirroring/raw/main/docs/screenshot.png</image>
        </screenshot>
    </screenshots>
    <launchable type="desktop-id">@app-id@.desktop</launchable>
    <url type="homepage">https://github.com/mkg20001/audio-mirroring</url>
    <url type="bugtracker">https://github.com/mkg20001/audio-mirroring/issues</url>
