<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="4.0"/>
    <template class="AudioSharingDropdown" parent="GtkWidget">
        <style>
            <class name="card"></class>
        </style>
        <child>     
            <object class="GtkDropDown" id="dropdown">
            </object>
        </child>
    </template>
</interface>